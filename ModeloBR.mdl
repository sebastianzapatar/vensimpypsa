	~	Months
	~		|

Mean Availability Margin=
	Sum(Availability Margin[Hour!])/24
	~	Dmnl
	~		|

Min Availability Margin=
	vmin(Availability Margin[Hour!])
	~	Dmnl
	~		|

Scarcity price factor=
	GET XLS CONSTANTS( '?Datos', 'Base', 'C9')
	~	Dmnl
	~		|

